<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>oxide_gnss</name>
  <version>0.1.0</version>
  <description>A Rust-based ROS2 GNSS driver with integrated NTRIP client</description>
  <maintainer email="gsokoll@example.com">gsokoll</maintainer>
  <license>MIT</license>

  <url type="repository">https://github.com/gsokoll/oxide_gnss</url>

  <buildtool_depend>ament_cargo</buildtool_depend>

  <depend>rclrs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>oxide_gnss_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
