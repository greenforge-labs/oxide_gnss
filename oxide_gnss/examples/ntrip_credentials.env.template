# NTRIP Credentials Template
#
# Copy this file to: ntrip_credentials.env
# Then fill in your credentials.
#
# The ntrip_credentials.env file is gitignored and will NOT be committed.
#
# Usage:
#   cp ntrip_credentials.env.template ntrip_credentials.env
#   # Edit ntrip_credentials.env with your credentials
#   ./ntrip_test_suite.sh --connect

# ============================================================================
# RTK2go (rtk2go.com)
# - Free community RTK service
# - Registration: Just use your email address
# - No password required (or use email again)
# ============================================================================
export NTRIP_RTK2GO_USER="your.email@example.com"
export NTRIP_RTK2GO_PASS=""

# ============================================================================
# EUREF-IP (euref-ip.net)
# - European Reference Frame
# - Registration: https://www.euref-ip.net/home (requires approval)
# ============================================================================
export NTRIP_EUREF_USER=""
export NTRIP_EUREF_PASS=""

# ============================================================================
# IGS-IP (igs-ip.net / products.igs-ip.net)
# - International GNSS Service
# - Registration: https://igs-ip.net/ (requires approval)
# ============================================================================
export NTRIP_IGS_USER=""
export NTRIP_IGS_PASS=""

# ============================================================================
# AUSCORS (auscors.ga.gov.au)
# - Geoscience Australia
# - Registration: https://gnss.ga.gov.au/ (Australian government service)
# ============================================================================
export NTRIP_AUSCORS_USER=""
export NTRIP_AUSCORS_PASS=""

# ============================================================================
# BKG (igs.bkg.bund.de / ntrip.bkg.bund.de)
# - German Federal Agency for Cartography and Geodesy
# - Registration: https://igs.bkg.bund.de/
# ============================================================================
export NTRIP_BKG_USER=""
export NTRIP_BKG_PASS=""

# ============================================================================
# Centipede (caster.centipede.fr)
# - French community RTK network
# - Open access (no credentials typically needed for most streams)
# ============================================================================
# Usually no credentials needed for Centipede
