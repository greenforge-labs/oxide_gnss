# NTRIP Credentials Template
#
# Copy this file to: ntrip_credentials.env
# Then fill in your credentials.
#
# The ntrip_credentials.env file is gitignored and will NOT be committed.
#
# Usage:
#   cp ntrip_credentials.env.template ntrip_credentials.env
#   # Edit ntrip_credentials.env with your credentials
#   ./ntrip_test_suite.sh --connect

# ============================================================================
# RTK2go (rtk2go.com)
# - Free community RTK service
# - Username: Must be a valid email address
# - Password: Must be "none" (literal string)
# - See: http://rtk2go.com/
# ============================================================================
export NTRIP_RTK2GO_USER="your.email@example.com"
export NTRIP_RTK2GO_PASS="none"

# ============================================================================
# EUREF-IP (euref-ip.net)
# - European Reference Frame
# - Registration: https://www.euref-ip.net/home (requires approval)
# ============================================================================
export NTRIP_EUREF_USER=""
export NTRIP_EUREF_PASS=""

# ============================================================================
# IGS-IP (igs-ip.net / products.igs-ip.net)
# - International GNSS Service
# - Registration: https://igs-ip.net/ (requires approval)
# ============================================================================
export NTRIP_IGS_USER=""
export NTRIP_IGS_PASS=""

# ============================================================================
# AUSCORS (auscors.ga.gov.au)
# - Geoscience Australia
# - Registration: https://gnss.ga.gov.au/ (Australian government service)
# ============================================================================
export NTRIP_AUSCORS_USER=""
export NTRIP_AUSCORS_PASS=""

# ============================================================================
# BKG (igs.bkg.bund.de / ntrip.bkg.bund.de)
# - German Federal Agency for Cartography and Geodesy
# - Registration: https://igs.bkg.bund.de/
# ============================================================================
export NTRIP_BKG_USER=""
export NTRIP_BKG_PASS=""

# ============================================================================
# Centipede (caster.centipede.fr)
# - French community RTK network
# - Open access (no credentials typically needed for most streams)
# ============================================================================
# Usually no credentials needed for Centipede

# ============================================================================
# Emlid Caster - Local Base Station (caster.emlid.com)
# - For testing against your own Emlid Reach base station
# - Mountpoint and credentials from your Emlid account
# ============================================================================
export NTRIP_EMLID_HOST="caster.emlid.com"
export NTRIP_EMLID_PORT="2101"
export NTRIP_EMLID_MOUNT=""
export NTRIP_EMLID_USER=""
export NTRIP_EMLID_PASS=""

# ============================================================================
# Test Location Overrides (Optional)
# - Override these to test from different simulated positions
# - Useful for finding mountpoints nearest to your actual location
# ============================================================================
# Australian tests (default: Brisbane)
# export TEST_LAT_AU="-27.47"
# export TEST_LON_AU="153.02"

# European tests (default: Berlin)
# export TEST_LAT_EU="52.52"
# export TEST_LON_EU="13.41"

# French tests (default: Paris)
# export TEST_LAT_FR="48.86"
# export TEST_LON_FR="2.35"

# North American tests (default: New York)
# export TEST_LAT_NA="40.71"
# export TEST_LON_NA="-74.00"

# Global casters like RTK2go (default: same as AU)
# export TEST_LAT_GLOBAL="-27.47"
# export TEST_LON_GLOBAL="153.02"

# ============================================================================
# Proximity Test Configuration
# - Set your base station's actual location for distance-based testing
# - PROXIMITY_OFFSETS defines test distances in degrees (~111km per degree)
# ============================================================================
# Your Emlid base station's actual coordinates
# export NTRIP_EMLID_BASE_LAT="-27.47"
# export NTRIP_EMLID_BASE_LON="153.02"

# Distance offsets to test (degrees): 0=at base, 0.1≈11km, 0.5≈55km, 1.0≈111km, 2.0≈222km
# export PROXIMITY_OFFSETS="0.0 0.1 0.5 1.0 2.0"

# ============================================================================
# Stress Test Configuration
# ============================================================================
# Number of connect/disconnect cycles for stress testing
# export STRESS_TEST_CYCLES="5"
